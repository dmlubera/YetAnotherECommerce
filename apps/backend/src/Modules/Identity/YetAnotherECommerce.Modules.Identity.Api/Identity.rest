@moduleUrl = http://localhost:5001/identity-module
@email = test@yetanotherecommerce.com
@password = Super$ecret123

### Sign-up
POST {{moduleUrl}}/sign-up
Content-Type: application/json

{
    "email": "{{email}}",
    "password": "{{password}}"
}

### Sign-in
# @name signIn
POST {{moduleUrl}}/sign-in
Content-Type: application/json

{
    "email": "{{email}}",
    "password": "{{password}}"
}

### 
@auth_token = {{signIn.response.body.$.accessToken}}

### Confirm email
POST {{moduleUrl}}/confirm-email
Content-Type: application/json

{
  "userId": "",
  "token": ""
}

### Resend email confirmation
POST {{moduleUrl}}/resend-email-confirmation
Content-Type: application/json

{
  "email": "{{email}}"
}

### Request password reset
POST {{moduleUrl}}/request-password-reset
Content-Type: application/json

{
  "email": "{{email}}"
}

### Reset password
POST {{moduleUrl}}/reset-password
Content-Type: application/json

{
  "userId": "",
  "token": "",
  "password": "newSuper$ecret123"
}


### Change password
POST {{moduleUrl}}/account/change-password
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "currentPassword": "{{password}}",
    "newPassword": "newSuper$ecret123"
}